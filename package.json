{
  "name": "stuck-js",
  "version": "2.1.4",
  "description": "A sticky library that stacks multiple sticky elements and keeps them aligned on horizontal scroll, with no dependencies",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --mode docs --watch",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:docs": "vite build --mode docs",
    "lint": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true",
    "semantic-release": "semantic-release"
  },
  "author": "Ryonkmr",
  "keywords": [
    "sticky",
    "scroll",
    "fixed"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RyoNkmr/stuck-js.git"
  },
  "bugs": {
    "url": "https://github.com/RyoNkmr/stuck-js/issues"
  },
  "homepage": "https://ryonkmr.github.io/stuck-js/",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "playwright": "^1.62.0",
    "semantic-release": "^25.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      "@semantic-release/npm"
    ]
  }
}
